CAPI=2:
# =============================================================================
# FuseSoC core for the ARF minimal Ibex SoC (team-compat wrapper).
#
# The file list mirrors dv/xsim/filelist.f — KEEP THEM IN SYNC (the native
# flows, ibex_soc.bat / ibex_soc.sh, read filelist.f directly and stay the
# supported path; this core exists so FuseSoC-based team flows build the
# same RTL). Self-contained on purpose: no `depend:` on the vendored
# lowRISC cores, so FuseSoC never has to resolve that tree.
#
#   fusesoc --cores-root=. run --target=lint  arf:ibex:minimal_ibex_soc
#   fusesoc --cores-root=. run --target=sim   arf:ibex:minimal_ibex_soc
#   fusesoc --cores-root=. run --target=synth arf:ibex:minimal_ibex_soc
#
# sim = tb_soc under Verilator 5 (--timing). Run ./ibex_soc.sh images first
# (the testbench $readmemh images are generated, not committed). The other
# 9 testbenches run through ./ibex_soc.sh sim <tb>.
# =============================================================================
name: arf:ibex:minimal_ibex_soc:1.1.0
description: Minimal Ibex RV32IMC SoC (OBI->Wishbone, XIP, FreeRTOS) - GF180MCU tapeout candidate

filesets:
  # $readmemh images referenced with repo-relative paths — copyto keeps the
  # same layout inside the FuseSoC work dir (the fix Ravalika's 498798b made
  # for the team tree, adopted here).
  files_mem:
    files:
      - rtl/system/boot.mem: { file_type: user, copyto: rtl/system/boot.mem }

  files_rtl:
    files:
      # ---- packages ----
      - vendor/lowrisc_ip/ip/prim/rtl/prim_util_pkg.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_count_pkg.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_mubi_pkg.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_secded_pkg.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_ram_1p_pkg.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_ram_2p_pkg.sv
      - vendor/lowrisc_ibex/rtl/ibex_pkg.sv
      - vendor/pulp_riscv_dbg/src/dm_pkg.sv
      - rtl/system/jtag_id_pkg.sv
      # ---- include files (macro headers pulled in by `include) ----
      - vendor/lowrisc_ip/ip/prim/rtl/prim_assert.sv: { is_include_file: true }
      - vendor/lowrisc_ip/ip/prim/rtl/prim_assert_dummy_macros.svh: { is_include_file: true }
      - vendor/lowrisc_ip/ip/prim/rtl/prim_assert_standard_macros.svh: { is_include_file: true }
      - vendor/lowrisc_ip/ip/prim/rtl/prim_assert_sec_cm.svh: { is_include_file: true }
      - vendor/lowrisc_ip/ip/prim/rtl/prim_assert_yosys_macros.svh: { is_include_file: true }
      - vendor/lowrisc_ip/ip/prim/rtl/prim_flop_macros.sv: { is_include_file: true }
      - vendor/lowrisc_ip/ip/prim/rtl/prim_macros.svh: { is_include_file: true }
      - vendor/lowrisc_ibex/vendor/lowrisc_ip/dv/sv/dv_utils/dv_fcov_macros.svh: { is_include_file: true }
      # ---- primitive shims + real prim RTL ----
      - dv/xsim/prim_shims.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_count.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_fifo_sync_cnt.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_fifo_sync.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_flop_2sync.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_sync_reqack.sv
      - vendor/lowrisc_ip/ip/prim/rtl/prim_fifo_async_simple.sv
      # ---- Ibex CPU core ----
      - vendor/lowrisc_ibex/rtl/ibex_alu.sv
      - vendor/lowrisc_ibex/rtl/ibex_branch_predict.sv
      - vendor/lowrisc_ibex/rtl/ibex_compressed_decoder.sv
      - vendor/lowrisc_ibex/rtl/ibex_controller.sv
      - vendor/lowrisc_ibex/rtl/ibex_core.sv
      - vendor/lowrisc_ibex/rtl/ibex_counter.sv
      - vendor/lowrisc_ibex/rtl/ibex_csr.sv
      - vendor/lowrisc_ibex/rtl/ibex_cs_registers.sv
      - vendor/lowrisc_ibex/rtl/ibex_decoder.sv
      - vendor/lowrisc_ibex/rtl/ibex_dummy_instr.sv
      - vendor/lowrisc_ibex/rtl/ibex_ex_block.sv
      - vendor/lowrisc_ibex/rtl/ibex_fetch_fifo.sv
      - vendor/lowrisc_ibex/rtl/ibex_icache.sv
      - vendor/lowrisc_ibex/rtl/ibex_id_stage.sv
      - vendor/lowrisc_ibex/rtl/ibex_if_stage.sv
      - vendor/lowrisc_ibex/rtl/ibex_load_store_unit.sv
      - vendor/lowrisc_ibex/rtl/ibex_lockstep.sv
      - vendor/lowrisc_ibex/rtl/ibex_multdiv_fast.sv
      - vendor/lowrisc_ibex/rtl/ibex_multdiv_slow.sv
      - vendor/lowrisc_ibex/rtl/ibex_pmp.sv
      - vendor/lowrisc_ibex/rtl/ibex_prefetch_buffer.sv
      - vendor/lowrisc_ibex/rtl/ibex_register_file_ff.sv
      - vendor/lowrisc_ibex/rtl/ibex_register_file_fpga.sv
      - vendor/lowrisc_ibex/rtl/ibex_register_file_latch.sv
      - vendor/lowrisc_ibex/rtl/ibex_top.sv
      - vendor/lowrisc_ibex/rtl/ibex_wb_stage.sv
      # ---- RISC-V debug module ----
      - vendor/pulp_riscv_dbg/debug_rom/debug_rom.sv
      - vendor/pulp_riscv_dbg/debug_rom/debug_rom_one_scratch.sv
      - vendor/pulp_riscv_dbg/src/dm_sba.sv
      - vendor/pulp_riscv_dbg/src/dm_csrs.sv
      - vendor/pulp_riscv_dbg/src/dm_mem.sv
      - vendor/pulp_riscv_dbg/src/dmi_cdc.sv
      - vendor/pulp_riscv_dbg/src/dmi_jtag.sv
      - vendor/pulp_riscv_dbg/src/dmi_jtag_tap.sv
      - vendor/pulp_riscv_dbg/src/dmi_bscane_tap.sv
      # ---- timer ----
      - vendor/lowrisc_ibex/shared/rtl/timer.sv
      # ---- demo system RTL ----
      - rtl/system/debounce.sv
      - rtl/system/gpio.sv
      - rtl/system/uart.sv
      - rtl/system/spi_host.sv
      - rtl/system/spi_top.sv
      - rtl/system/boot_rom.sv
      - rtl/system/spi_flash_xip.sv
      - rtl/system/sram_controller.sv
      - rtl/system/sram_model.sv
      - rtl/system/dffram.sv
      - rtl/system/wb_interconnect.sv
      - rtl/system/obi2wb.sv
      - rtl/system/pwm.sv
      - rtl/system/pwm_wrapper.sv
      # .v extension but SV content (the native flow reads everything -sv)
      - rtl/system/i2c_wb_wrapper.v: { file_type: systemVerilogSource }
      - rtl/system/i2c_master_top.v: { file_type: systemVerilogSource }
      - rtl/system/i2c_master_byte_ctrl.v: { file_type: systemVerilogSource }
      - rtl/system/i2c_master_bit_ctrl.v: { file_type: systemVerilogSource }
      - rtl/system/dm_top.sv
      - rtl/system/wrapper_top.sv
      - rtl/system/ibex_demo_system.sv
    file_type: systemVerilogSource

  files_dv:
    files:
      - dv/xsim/sim_stubs.sv
      - dv/xsim/spi_nor_flash_model.sv
      - dv/xsim/periph_models.sv
      - rtl/system/i2c_slave_bfm.sv
      - dv/xsim/tb_soc.sv
      - dv/xsim/boot_sram_dv.mem: { file_type: user, copyto: dv/xsim/boot_sram_dv.mem }
      - sw/asm-demo/sram_init_sim.vmem: { file_type: user, copyto: sw/asm-demo/sram_init_sim.vmem }
    file_type: systemVerilogSource

  files_fpga:
    files:
      - rtl/fpga/top_artya7.sv
      - vendor/lowrisc_ibex/shared/rtl/fpga/xilinx/clkgen_xil7series.sv
      - data/pins_artya7.xdc: { file_type: xdc }
    file_type: systemVerilogSource

parameters:
  FPGA_XILINX:
    datatype: bool
    paramtype: vlogdefine
    description: Select real Xilinx primitives (BUFGCE clock gate, BSCANE2 JTAG tap)

targets:
  default: &default
    filesets: [files_mem, files_rtl]
    toplevel: ibex_demo_system

  lint:
    <<: *default
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options: [--timing, -Wno-fatal]

  sim:
    filesets: [files_mem, files_rtl, files_dv]
    toplevel: tb_soc
    default_tool: verilator
    tools:
      verilator:
        verilator_options: [--timing, --main, -Wno-fatal, --quiet-stats, -j, "0"]
        # -O2 instead of Verilator's -Os default: faster sim, and dodges a
        # MinGW GCC-16 -Os link bug (WALKTHROUGH gotcha 30b)
        make_options: [OPT_FAST=-O2, OPT_SLOW=-O2, OPT_GLOBAL=-O2]

  synth:
    filesets: [files_mem, files_rtl, files_fpga]
    toplevel: top_artya7
    default_tool: vivado
    parameters: [FPGA_XILINX=true]
    tools:
      vivado:
        part: xc7a100tcsg324-1
